---
// Un caso por cada archivo de src/content/proyectos/es/ (la dirección es el nombre del archivo).
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { cases } from '../../../lib/contenido.js';

export function getStaticPaths() {
  return cases.map((item) => ({ params: { caso: item.key }, props: { item } }));
}

const { item } = Astro.props;
const c = item.es;
---
<Base lang="es" pageKey={item.key} active="projects" title={`${c.title} · Sebas Padilla Lab`} description={c.description}>
  <CaseStudy lang="es" item={item} />
</Base>
