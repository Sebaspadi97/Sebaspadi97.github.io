---
// English version of a case: one per file in src/content/proyectos/en/.
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { cases } from '../../../lib/contenido.js';

export function getStaticPaths() {
  return cases.filter((item) => item.en).map((item) => ({ params: { slug: item.enSlug }, props: { item } }));
}

const { item } = Astro.props;
const c = item.en;
---
<Base lang="en" pageKey={item.key} active="projects" title={`${c.title} · Sebas Padilla Lab`} description={c.description}>
  <CaseStudy lang="en" item={item} />
</Base>
