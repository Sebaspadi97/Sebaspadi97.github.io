---
// Temporary English routes for pages not built yet (see src/data/pending.js).
import Base from '../../layouts/Base.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import { pending } from '../../data/pending.js';
import { routes } from '../../i18n/index.js';

export function getStaticPaths() {
  return pending
    .filter((p) => p.en && routes[p.key] && routes[p.key].en)
    .map((p) => ({
      params: { page: routes[p.key].en.replace(/^\/en\//, '').replace(/\/$/, '') },
      props: { item: p },
    }));
}

const { item } = Astro.props;
---
<Base
  lang="en"
  pageKey={item.key}
  active={item.active}
  title={`${item.en.title} · Sebas Padilla Lab`}
  description="Sebas Padilla Lab: from data to decisions."
  noindex
>
  <ComingSoon lang="en" label={item.en.label} title={item.en.title} />
</Base>
