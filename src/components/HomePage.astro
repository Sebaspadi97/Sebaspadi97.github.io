---
// Inicio (rediseño A + C, 28 oct 2026): cuaderno de laboratorio con una historia guiada por el
// scroll en "El método". Portada con muestra viva y hallazgo, método fijo, carril de proyectos,
// dato curioso con contador, manifiesto con servicios accionables y Desde el Lab.
// Se usa en /es/ y /en/; los textos están en src/data/home.js.
import LiveSample from './LiveSample.astro';
import MethodScrolly from './MethodScrolly.astro';
import ChurnSimulator from './ChurnSimulator.astro';
import LabCover from './LabCover.astro';
import { posts as labPosts, cases } from '../lib/contenido.js';
import { home } from '../data/home.js';
import { link, hasLang, ui } from '../i18n/index.js';
import { site } from '../data/site.js';
import { dims, srcset } from '../lib/img.js';

const { lang = 'es' } = Astro.props;
const es = lang === 'es';
const c = home[lang];
const t = ui[lang];
const cvHref = site.cv[lang] || link('about', lang);
const f = c.projects.featured;
const labPost = (key) => labPosts.find((x) => x.key === key);
const caseOf = (key) => cases.find((x) => x.key === key);
const spanishOnly = (key) => lang === 'en' && !hasLang(key, 'en');
// Si un proyecto o artículo deja de publicarse, su tarjeta desaparece del Inicio.
const published = (key) => Boolean(caseOf(key) || labPost(key));
const cards = c.projects.cards.filter((p) => published(p.key));
const labItems = c.lab.items.filter((a) => published(a.key));
const L = es
  ? { fig: 'Proyectos', prev: 'Proyecto anterior', next: 'Proyecto siguiente', rail: 'Proyectos destacados', read: 'Leer el caso', count: 'proyectos, de la pregunta a la decisión.', notebook: 'Cuaderno', manifesto: 'Manifiesto', readPost: 'Leer', services: 'Servicios' }
  : { fig: 'Projects', prev: 'Previous project', next: 'Next project', rail: 'Featured projects', read: 'Read the case', count: 'projects, from the question to the decision.', notebook: 'Notebook', manifesto: 'Manifesto', readPost: 'Read', services: 'Services' };
const quoteWords = c.manifesto.quote.split(' ');
---
<!-- Portada -->
<section class="hero paper-grid" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-meta">
      <span>{c.hero.metaLeft}</span>
      <span>{c.hero.metaRight}</span>
    </div>
    <div class="hero-grid">
      <div class="hero-text">
        <h1 id="hero-title" class="hero-title">
          {c.hero.headlineBefore}<span class="mark">{c.hero.headlineMark}</span>{c.hero.headlineAfter}
        </h1>
        <p class="hero-intro">{c.hero.intro}</p>
        <p class="hero-sub">{c.hero.sub}</p>
        <div class="actions">
          <a class="pill pill--primary" href={link('projects', lang)}>{c.hero.primary} <span class="arr" aria-hidden="true">→</span></a>
          <a class="pill pill--outline" href={cvHref}>{c.hero.secondary}</a>
        </div>
      </div>
      <div class="hero-figure">
        <LiveSample lang={lang} title={c.hero.figure} hint={c.hero.figureHint} label={c.hero.figureLabel} />
        <div class="proof">
          <span class="proof-k">{c.hero.proof}</span>
          <span class="proof-nums"><span class="proof-win">{f.chart.modelValue}</span> <span class="proof-lose"><span class="visually-hidden">{es ? 'frente a' : 'versus'} </span>{f.chart.allValue}</span></span>
          <span class="proof-text">{c.hero.proofText}</span>
          <a class="proof-link" href={link(f.key, lang)}>{c.hero.proofLink} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- El método -->
<MethodScrolly lang={lang} fig={c.method.label} title={c.method.title} hint={c.method.hint} label={c.method.figure} steps={c.method.steps} />

<!-- Proyectos -->
<section class="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="fig"><span><b>Fig. 02</b> · {L.fig}</span></p>
        <h2 id="projects-title" class="sec-title">{c.projects.title}</h2>
      </div>
      <div class="rail-ctl">
        <a class="link-more" href={link('projects', lang)}>{c.projects.all} <span class="arr" aria-hidden="true">→</span></a>
        <button type="button" class="rail-btn" data-rail-prev aria-label={L.prev} aria-controls="rail" hidden>←</button>
        <button type="button" class="rail-btn" data-rail-next aria-label={L.next} aria-controls="rail" hidden>→</button>
      </div>
    </div>
  </div>

  <ul class="rail" id="rail" aria-label={L.rail} data-rail>
    <li class="rail-item rail-item--lg">
      <article class="pcard pcard--feat">
        <div class="feat-body">
          <span class="ptag ptag--dark">{f.pillar}</span>
          <h3 class="pcard-title"><a href={link(f.key, lang)}>{f.title}</a></h3>
          <p class="pcard-q">{f.question}</p>
          <p class="finding finding--lg"><strong>{c.projects.findingLabel}:</strong> {f.finding}</p>
          <a class="pcard-more" href={link(f.key, lang)}>{L.read} <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <div class="feat-viz">
          <ChurnSimulator lang={lang} variant="card" />
        </div>
      </article>
    </li>
    {cards.map((p) => {
      const cs = caseOf(p.key);
      return (
        <li class="rail-item">
          <article class="pcard">
            <div class="pcard-cover">
              {cs?.thumb && <img src={cs.thumb} srcset={srcset(cs.thumb)} sizes="(max-width: 760px) 82vw, 560px" alt="" loading="lazy" decoding="async" width={dims(cs.thumb)[0]} height={dims(cs.thumb)[1]} />}
              <p class="finding finding--cover"><strong>{c.projects.findingLabel}:</strong> {p.finding}</p>
            </div>
            <div class="pcard-body">
              <span class="pcard-top">
                <span class:list={['ptag', `ptag--${p.pillarTone}`]}>{p.pillar}</span>
                {spanishOnly(p.key) && <span class="tag">{t.inSpanish}</span>}
              </span>
              <h3 class="pcard-title"><a class="stretched" href={link(p.key, lang)}>{p.title}</a></h3>
              <p class="pcard-q">{p.question}</p>
              <span class="pcard-more" aria-hidden="true">{L.read} <span class="arr">→</span></span>
            </div>
          </article>
        </li>
      );
    })}
    <li class="rail-item">
      <a class="pcard pcard--end" href={link('projects', lang)}>
        <span class="end-n" aria-hidden="true">{cases.length}</span>
        <span class="end-text">{cases.length} {L.count}</span>
        <span class="pcard-more">{c.projects.all} <span class="arr" aria-hidden="true">→</span></span>
      </a>
    </li>
  </ul>
  <div class="container"><div class="rail-bar" aria-hidden="true"><span data-rail-bar></span></div></div>
</section>

<!-- Dato curioso -->
<section class="fact" aria-labelledby="fact-label">
  <div class="container fact-grid">
    <p class="counter rv" aria-hidden="true"><span data-count={c.fact.figure}>{c.fact.figure}</span><small>{c.fact.figureLabel}</small></p>
    <div class="fact-copy rv" style="--i:1">
      <p id="fact-label" class="fig fig--ink"><span>{c.fact.label}</span></p>
      <p class="fact-text">{c.fact.text}</p>
      <p class="fact-source">{c.fact.source}</p>
      <a class="pill pill--dark" href={link(c.fact.key, lang)}>{c.fact.button} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- Manifiesto y servicios -->
<section class="manifesto" aria-labelledby="quote-title">
  <div class="container">
    <p class="fig fig--dark"><span><b>Fig. 03</b> · {L.manifesto}</span></p>
    <h2 id="quote-title" class="quote" aria-label={c.manifesto.quote} data-words>
      {quoteWords.map((w) => <span class:list={['w', { gold: /^decisi/i.test(w) }]} aria-hidden="true">{w} </span>)}
    </h2>
    <p class="quote-sub">{c.manifesto.sub}</p>

    <h3 class="visually-hidden">{L.services}</h3>
    <p class="fig fig--dark services-label"><span>{c.services.label}</span></p>
    <ul class="svc-list">
      {c.services.items.map((s, i) => (
        <li class="rv" style={`--i:${i}`}>
          <a class="svc" href={link(s.key, lang) + (s.query || '')}>
            <span class="svc-name">{s.name}</span>
            <span class="svc-text">{s.text}</span>
            <span class="svc-cta">{s.cta} <span class="arr" aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="svc-foot">
      <a class="pill pill--mint" href={link('contact', lang) + '?motivo=proyecto'}>{c.services.button} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- Desde el Lab -->
<section class="lab paper-grid" aria-labelledby="lab-title">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="fig"><span><b>Fig. 04</b> · {L.notebook}</span></p>
        <h2 id="lab-title" class="sec-title">{c.lab.title}</h2>
      </div>
      <a class="link-more" href={link('lab', lang)}>{c.lab.more} <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <ul class="lab-grid">
      {labItems.map((a, i) => (
        <li class="rv" style={`--i:${i}`}>
          <article class="pcard pcard--lab">
            <div class="pcard-cover pcard-cover--lab">{labPost(a.key) && <LabCover cover={labPost(a.key).cover} size="sm" decorative />}</div>
            <div class="pcard-body">
              <span class="pcard-top">
                <span class:list={['ptag', `ptag--${a.tone}`]}>{a.category}</span>
                {spanishOnly(a.key) && <span class="tag">{t.inSpanish}</span>}
              </span>
              <h3 class="pcard-title pcard-title--sm"><a class="stretched" href={link(a.key, lang)}>{a.title}</a></h3>
              <span class="pcard-more" aria-hidden="true">{L.readPost} <span class="arr">→</span></span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Carril de proyectos: flechas y barra de avance
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
  const bar = document.querySelector<HTMLElement>('[data-rail-bar]');
  if (rail && prev && next && bar) {
    prev.hidden = next.hidden = false;
    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const seen = rail.clientWidth / rail.scrollWidth;
      const p = max > 0 ? rail.scrollLeft / max : 1;
      bar.style.setProperty('--rp', String(seen + p * (1 - seen)));
      prev.disabled = rail.scrollLeft < 8;
      next.disabled = rail.scrollLeft > max - 8;
    };
    const step = () => (rail.querySelector('.rail-item:not(.rail-item--lg)')?.getBoundingClientRect().width || 400) + 20;
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }));
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // Contador del dato curioso (el número final ya está en la página)
  const count = document.querySelector<HTMLElement>('[data-count]');
  if (count && !reduce && 'IntersectionObserver' in window) {
    const target = Number(count.dataset.count);
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1200);
        count.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.5 });
    if (count.getBoundingClientRect().top > window.innerHeight) { count.textContent = '0'; io.observe(count); }
  }

  // Manifiesto: las palabras se encienden al bajar
  const quote = document.querySelector<HTMLElement>('[data-words]');
  if (quote) {
    const words = [...quote.querySelectorAll('.w')];
    if (reduce) words.forEach((w) => w.classList.add('on'));
    else {
      quote.classList.add('is-live');
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = quote.getBoundingClientRect();
        const p = (window.innerHeight * 0.85 - r.top) / (r.height + window.innerHeight * 0.35);
        const n = Math.round(Math.max(0, Math.min(1, p)) * words.length);
        words.forEach((w, i) => w.classList.toggle('on', i < n));
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
  }
</script>

<style>
  /* ---------- Portada ---------- */
  .hero { padding-top: clamp(28px, 5vw, 56px); padding-bottom: clamp(56px, 8vw, 104px); border-bottom: 1px solid var(--gray-light); overflow: hidden; }
  .hero-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-bottom: 18px;
    margin-bottom: clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero-text { display: flex; flex-direction: column; gap: 18px; }
  .hero-title { font-weight: 800; font-size: clamp(44px, 6.6vw, 92px); line-height: 0.98; letter-spacing: -0.035em; color: var(--green-deep); text-wrap: balance; margin-bottom: 10px; }
  .mark { position: relative; color: var(--green); white-space: nowrap; }
  .mark::after { content: ''; position: absolute; left: 0; right: 0.08em; bottom: -0.02em; height: 0.085em; background: var(--gold); border-radius: 4px; transform-origin: left; animation: draw 1s .35s var(--ease-out) both; }
  @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .hero-intro { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; max-width: 60ch; }
  .hero-sub { color: var(--slate); max-width: 60ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .hero-figure { position: relative; }
  .proof {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(320px, 88%);
    margin: -72px -12px 0 auto;
    padding: 18px 20px 12px;
    border-radius: var(--radius-md);
    background: var(--green-night);
    color: var(--on-dark);
    box-shadow: 0 24px 40px -24px rgba(17, 41, 31, 0.7);
  }
  .proof-k { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mint-strong); }
  .proof-nums { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 14px; font-family: var(--font-display); font-variant-numeric: tabular-nums; }
  .proof-win { font-weight: 800; font-size: 28px; color: var(--white); white-space: nowrap; }
  .proof-lose { font-weight: 700; font-size: 15px; color: var(--on-dark-muted); white-space: nowrap; text-decoration: line-through; text-decoration-color: rgba(214, 166, 79, 0.8); }
  .proof-text { font-size: 14px; line-height: 1.5; }
  .proof-link { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--mint-strong); text-decoration: none; }
  .proof-link:hover { color: var(--white); }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-figure { max-width: 560px; }
    .proof { margin-right: 8px; }
  }
  @media (max-width: 520px) {
    .actions .pill { flex: 1 1 100%; }
    .proof { width: calc(100% - 16px); }
  }

  /* ---------- Encabezados de sección ---------- */
  .sec-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; margin-bottom: clamp(28px, 4vw, 44px); }
  .sec-head .sec-title { margin-top: 16px; max-width: 17ch; }
  .link-more { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--green); text-decoration: none; }
  .link-more:hover { text-decoration: underline; text-underline-offset: 5px; }

  /* ---------- Proyectos ---------- */
  .projects { padding-top: clamp(72px, 9vw, 120px); padding-bottom: clamp(56px, 7vw, 96px); }
  .rail-ctl { display: flex; align-items: center; gap: 10px; }
  .rail-btn { width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--green); background: transparent; color: var(--green); font: 700 18px/1 var(--font-display); cursor: pointer; transition: background .2s ease, color .2s ease, opacity .2s ease; }
  .rail-btn:hover:not(:disabled) { background: var(--green); color: var(--white); }
  .rail-btn:disabled { opacity: 0.3; cursor: default; }
  .rail-btn[hidden] { display: none; }
  .rail {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 4px var(--gutter) 24px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--gutter);
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  @media (min-width: 1360px) {
    .rail { padding-left: calc((100vw - var(--container)) / 2 + var(--gutter)); scroll-padding-left: calc((100vw - var(--container)) / 2 + var(--gutter)); }
  }
  .rail-item { flex: 0 0 min(540px, 82vw); scroll-snap-align: start; display: flex; min-width: 0; }
  .rail-item--lg { flex-basis: min(880px, 88vw); }
  .rail-bar { height: 3px; border-radius: 3px; background: var(--gray-light); overflow: hidden; }
  .rail-bar span { display: block; height: 100%; background: var(--gold); transform-origin: left; transform: scaleX(var(--rp, 0.3)); transition: transform .15s linear; }

  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--paper);
    border: 1px solid var(--gray-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--carbon);
    text-decoration: none;
    transition: transform .35s var(--ease-out), box-shadow .35s var(--ease-out), border-color .35s ease;
  }
  .pcard:hover { transform: translateY(-4px); box-shadow: 0 28px 48px -32px rgba(17, 41, 31, 0.45); border-color: var(--line); }
  .pcard-cover { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--gray-light); background: var(--paper); }
  .pcard-cover img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform .6s var(--ease-out); }
  .pcard:hover .pcard-cover img { transform: scale(1.035); }
  .finding--cover { position: absolute; left: 16px; right: 16px; bottom: 16px; max-width: 46ch; padding: 10px 14px; border-radius: 10px; font-family: var(--font-display); box-shadow: 0 12px 24px -16px rgba(17, 41, 31, 0.6); }
  .finding--lg { font-family: var(--font-display); font-size: 14px; padding: 10px 14px; border-radius: 10px; }
  .pcard-body { display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 24px; }
  .pcard-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .ptag { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green); }
  .ptag--mint, .ptag--teal { color: var(--teal-text); }
  .ptag--gold { color: var(--gold-text); }
  .ptag--green { color: var(--green); }
  .ptag--dark { color: var(--mint-strong); }
  .pcard-title { font-size: clamp(22px, 2.2vw, 28px); line-height: 1.15; color: var(--green-deep); }
  .pcard-title--sm { font-size: 22px; }
  .pcard-title a { color: inherit; text-decoration: none; }
  .stretched::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .pcard-q { color: var(--slate); font-size: 16px; }
  .pcard-more { display: inline-flex; align-items: center; gap: 8px; min-height: 32px; margin-top: 4px; font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--green); text-decoration: none; }
  .pcard .tag { color: var(--slate); }

  .pcard--feat { background: var(--green-deep); border-color: var(--green-deep); color: var(--on-dark); }
  .pcard--feat:hover { border-color: var(--green-deep); }
  .feat-body, .feat-viz { min-width: 0; }
  .pcard--feat { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .feat-body { display: flex; flex-direction: column; gap: 12px; padding: 26px; }
  .feat-body .pcard-title { color: var(--white); }
  .feat-body .pcard-title a:hover { color: var(--mint); text-decoration: underline; }
  .feat-body .pcard-q { color: var(--on-dark-muted); }
  .feat-body .pcard-more { color: var(--mint-strong); }
  .feat-viz { display: flex; padding: 20px; border-left: 1px solid rgba(140, 207, 173, 0.16); background:
    linear-gradient(rgba(140, 207, 173, 0.05) 1px, transparent 1px) 0 0 / 24px 24px,
    linear-gradient(90deg, rgba(140, 207, 173, 0.05) 1px, transparent 1px) 0 0 / 24px 24px; }
  .feat-viz :global(.sim--card) { background: transparent; padding: 0; }
  @media (max-width: 760px) {
    .pcard--feat { grid-template-columns: 1fr; }
    .feat-viz { border-left: 0; border-top: 1px solid rgba(140, 207, 173, 0.16); }
  }

  .pcard--end { justify-content: flex-end; gap: 10px; padding: 28px; min-height: 320px; background: var(--green); border-color: var(--green); color: var(--white); }
