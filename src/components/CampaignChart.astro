---
// Gráfico del caso de abandono: resultado de la campaña en el conjunto de prueba.
// Contactar a todos: −COP 10,2 M. Contactar al 15,5 % elegido por el modelo: +COP 2,8 M.
// (Se reemplaza por el simulador interactivo cuando esté listo.)
const { chart } = Astro.props;
---
<figure class="campaign-chart">
  <svg viewBox="0 0 400 190" role="img" aria-label={chart.label}>
    <line x1="200" y1="28" x2="200" y2="80" stroke="#2F8665" stroke-width="1.5" />
    <line x1="200" y1="102" x2="200" y2="150" stroke="#2F8665" stroke-width="1.5" />
    <rect x="34" y="34" width="166" height="40" rx="6" fill="#A9B5AE" />
    <rect x="200" y="104" width="46" height="40" rx="6" fill="#8CCFAD" />
    <text x="36" y="24" fill="#CFD8D2" font-size="13" font-family="Open Sans, sans-serif">{chart.all}</text>
    <text x="190" y="59" fill="#11291F" font-size="14" font-weight="700" text-anchor="end" font-family="Montserrat, sans-serif">{chart.allValue}</text>
    <text x="36" y="96" fill="#CFD8D2" font-size="13" font-family="Open Sans, sans-serif">{chart.model}</text>
    <text x="256" y="129" fill="#F8FAF7" font-size="14" font-weight="700" font-family="Montserrat, sans-serif">{chart.modelValue}</text>
    <circle cx="246" cy="124" r="5" fill="#D6A64F" />
  </svg>
  <figcaption>{chart.note}</figcaption>
</figure>

<style>
  .campaign-chart {
    flex: 1;
    margin: 0;
    padding: 20px;
    border-radius: var(--radius-md);
    background: var(--green-deep);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }
  .campaign-chart svg { width: 100%; height: auto; }
  .campaign-chart figcaption { font-size: 13px; color: var(--on-dark-muted); }
</style>
