---
// Pinta una lista de bloques de contenido de un caso (ver src/data/cases.js).
import { inline } from '../lib/text.js';
import sizes from '../data/image-sizes.json';
import ChurnSimulator from './ChurnSimulator.astro';
const { blocks = [], tone = 'light', lang = 'es' } = Astro.props;
const dims = (src) => sizes[src] || [1400, 933];
---
<div class:list={['blocks', `blocks--${tone}`]}>
  {blocks.map((b) => {
    if (b.sim) return <ChurnSimulator lang={lang} variant="full" />;
    if (b.lead) return <p class="b-lead" set:html={inline(b.lead)} />;
    if (b.p) return <p set:html={inline(b.p)} />;
    if (b.ul) return <ul class="b-list">{b.ul.map((i) => <li set:html={inline(i)} />)}</ul>;
    if (b.ol) return <ol class="b-list">{b.ol.map((i) => <li set:html={inline(i)} />)}</ol>;
    if (b.stats)
      return (
        <dl class="b-stats">
          {b.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.n}</dd>
            </div>
          ))}
        </dl>
      );
    if (b.table)
      return (
        <div class="b-table" tabindex="0" role="region" aria-label={b.table.head[0]}>
          <table>
            <thead>
              <tr>{b.table.head.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {b.table.rows.map((r) => (
                <tr>{r.map((c, i) => (i === 0 ? <th scope="row" set:html={inline(c)} /> : <td set:html={inline(c)} />))}</tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    if (b.fig)
      return (
        <figure class="b-fig">
          <a href={b.fig.src} class="b-fig-link">
            <img src={b.fig.src} alt={b.fig.alt} loading="lazy" decoding="async" width={dims(b.fig.src)[0]} height={dims(b.fig.src)[1]} />
          </a>
          <figcaption>{b.fig.caption}</figcaption>
        </figure>
      );
    return null;
  })}
</div>

<style>
  .blocks { display: flex; flex-direction: column; gap: 18px; }
  .blocks :global(strong) { font-weight: 600; color: inherit; }

  .b-lead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2vw, 23px);
    line-height: 1.4;
    color: var(--green);
  }
  .blocks--dark .b-lead { color: var(--white); }

  .b-list { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; }
  .b-list li::marker { color: var(--green); font-weight: 600; }
  .blocks--dark .b-list { color: var(--gray-light); }
  .blocks--dark .b-list li::marker { color: var(--gold); }

  .b-stats {
    margin: 4px 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 16px;
  }
  .b-stats div { border-top: 2px solid var(--green); padding-top: 10px; display: flex; flex-direction: column-reverse; }
  .b-stats dt { font-size: 14px; color: var(--slate); }
  .b-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.2;
    color: var(--green-deep);
  }

  .b-table {
    overflow-x: auto;
    border: 1px solid var(--gray-light);
    border-radius: var(--radius-md);
    background: var(--paper);
  }
  .b-table:focus-visible { outline-offset: 2px; }
  .b-table table { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.5; }
  .b-table th,
  .b-table td { padding: 10px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--gray-light); }
  .b-table thead th {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate);
    background: var(--white);
    white-space: nowrap;
  }
  .b-table tbody th { font-weight: 400; }
  .b-table tbody tr:last-child th,
  .b-table tbody tr:last-child td { border-bottom: 0; }
  .blocks--dark .b-table { background: var(--green-night); border-color: var(--green); }
  .blocks--dark .b-table table { color: var(--gray-light); }
  .blocks--dark .b-table th,
  .blocks--dark .b-table td { border-color: var(--green); }
  .blocks--dark .b-table thead th { background: transparent; color: var(--mint); }

  .b-fig { margin: 8px 0; display: flex; flex-direction: column; gap: 10px; }
  .b-fig-link { display: block; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--gray-light); }
  .b-fig img { width: 100%; height: auto; }
  .b-fig figcaption { font-size: 14px; color: var(--slate); }
</style>
