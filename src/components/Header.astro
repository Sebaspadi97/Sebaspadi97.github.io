---
// Menú editorial fijo: logo, enlaces en mayúsculas, página activa subrayada en dorado,
// ES/EN y "Hablemos". Al bajar se compacta y una línea dorada muestra el avance de lectura.
import { ui, link } from '../i18n/index.js';

const { lang = 'es', active = null, theme = 'light', altHref = '/' } = Astro.props;
const t = ui[lang];
const otherLang = lang === 'es' ? 'en' : 'es';
---
<header class:list={['site-header', `site-header--${theme}`]} data-header>
  <nav class="nav container" aria-label={t.navLabel}>
    <a class="brand" href={link('home', lang)}>
      <img
        src={theme === 'dark' ? '/brand/logo-horizontal-negativo.svg' : '/brand/logo-horizontal.svg'}
        alt={lang === 'es' ? 'Sebas Padilla Lab — Inicio' : 'Sebas Padilla Lab — Home'}
        width="125"
        height="46"
      />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-label-open={t.menu} data-label-close={t.close}>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
      <span class="nav-toggle-text">{t.menu}</span>
    </button>

    <div class="nav-menu" id="nav-menu">
      <ul class="nav-links">
        {t.nav.map((item) => (
          <li>
            <a
              href={link(item.key, lang)}
              aria-current={active === item.key ? 'page' : undefined}
              class:list={['nav-link', { 'is-active': active === item.key }]}
            >{item.label}</a>
          </li>
        ))}
      </ul>

      <p class="nav-lang">
        <span class="visually-hidden">{t.langLabel}: </span>
        {lang === 'es'
          ? <><span aria-current="true">ES</span> / <a href={altHref} hreflang={otherLang} lang={otherLang}>EN</a></>
          : <><a href={altHref} hreflang={otherLang} lang={otherLang}>ES</a> / <span aria-current="true">EN</span></>}
      </p>

      <a class="pill nav-cta" href={link('contact', lang)}>{t.cta}</a>
    </div>
  </nav>
  <span class="read-progress" aria-hidden="true"></span>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const text = toggle.querySelector('.nav-toggle-text');
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      if (text) text.textContent = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (open) menu.querySelector('a')?.focus();
    };
    menu.addEventListener('click', (e) => {
      if (e.target.closest('a') && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // Menú compacto y avance de lectura (un solo manejador de scroll, con requestAnimationFrame)
  const header = document.querySelector('[data-header]');
  if (header) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 24);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      header.style.setProperty('--p', max > 0 ? (y / max).toFixed(4) : '0');
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--gray-light);
    background: rgba(248, 250, 247, 0.9);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    transition: box-shadow .25s ease;
  }
  .site-header.is-scrolled { box-shadow: 0 6px 24px -18px rgba(17, 41, 31, 0.5); }
  .read-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--gold);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .site-header--dark {
    background: rgba(17, 41, 31, 0.92);
    border-bottom: 1px solid var(--green);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding: 4px 0;
    border-radius: 6px;
  }
  .brand img {
    display: block;
    height: 46px;
    width: auto;
    transform-origin: left center;
    transition: transform .3s var(--ease-out);
  }
  /* Al bajar, el logo se reduce sin cambiar la altura del menú (no mueve el contenido) */
  .is-scrolled .brand img { transform: scale(0.87); }
  @media (prefers-reduced-motion: reduce) {
    .nav, .brand img, .site-header { transition: none; }
  }
  @media (max-width: 480px) {
    .brand img { height: 40px; }
  }

  .nav-menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    color: var(--carbon);
    text-decoration: none;
    padding: 10px 0;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .3s var(--ease-out);
  }
  .nav-link:hover { color: var(--green); }
  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); }
  .nav-link.is-active { color: var(--green); }
  .site-header--dark .nav-link { color: var(--gray-light); }
  .site-header--dark .nav-link:hover,
  .site-header--dark .nav-link.is-active { color: var(--mint); }

  .nav-lang { margin: 0; color: var(--slate); }
  .nav-lang a { color: var(--slate); }
  .nav-lang a:hover { color: var(--green); }
  .nav-lang [aria-current] { color: var(--carbon); }
  .site-header--dark .nav-lang,
  .site-header--dark .nav-lang a { color: var(--on-dark-muted); }
  .site-header--dark .nav-lang [aria-current] { color: var(--white); }

  .nav-cta {
    background: var(--carbon);
    color: var(--white);
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
    letter-spacing: 0.06em;
  }
  .nav-cta:hover { background: var(--green); color: var(--white); }
  .site-header--dark .nav-cta { background: var(--mint); color: var(--green-night); }
  .site-header--dark .nav-cta:hover { background: var(--white); }

  /* Botón de menú en pantallas pequeñas */
  .nav-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--carbon);
    background: transparent;
    color: var(--carbon);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .site-header--dark .nav-toggle { border-color: var(--mint); color: var(--white); }
  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
  }
  .nav-toggle-bars::before,
  .nav-toggle-bars::after { content: ''; position: absolute; left: 0; }
  .nav-toggle-bars::before { top: -5px; }
  .nav-toggle-bars::after { top: 5px; }

  @media (max-width: 900px) {
    .nav-toggle { display: inline-flex; }
    .nav-menu {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 12px 0 20px;
    }
    .nav-menu.is-open { display: flex; }
    .nav-link::after { display: none; }
    .nav-link.is-active { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 3px; text-underline-offset: 6px; }
    .nav-links { flex-direction: column; gap: 4px; }
    .nav-link { display: inline-block; font-size: 16px; padding: 8px 0; }
  }
</style>
