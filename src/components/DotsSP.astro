---
// Figura de "El método": puntos dispersos que se ordenan hasta formar SP.
// Un solo punto dorado (arriba a la izquierda de la P) = la decisión.
// Sin JavaScript o con movimiento reducido, la figura se muestra ya ordenada.
const { label = 'Campo de puntos dispersos que se ordenan hasta formar las letras SP' } = Astro.props;

const W = 560;
const H = 420;
const S = ['.####', '#....', '#....', '.###.', '....#', '....#', '####.'];
const P = ['####.', '#...#', '#...#', '####.', '#....', '#....', '#....'];
const cell = 30;
const ox = 220;
const oy = 100;

let seed = 7;
const rnd = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const pct = (v, total) => `${((v / total) * 100).toFixed(3)}%`;

// Puntos que forman SP: posición final (x1, y1) y posición dispersa inicial (x0, y0)
const letters = [];
let i = 0;
for (let r = 0; r < 7; r++) {
  for (let c = 0; c < 5; c++) {
    const pushDot = (x, y, color) => {
      const x0 = Math.round(rnd() * 500 + 20);
      const y0 = Math.round(rnd() * 360 + 20);
      letters.push({
        style: [
          `--x0: ${pct(x0, W)}`,
          `--y0: ${pct(y0, H)}`,
          `--x1: ${pct(x, W)}`,
          `--y1: ${pct(y, H)}`,
          `--size: ${pct(15, W)}`,
          `--delay: ${(i % 12) * 45}ms`,
          `background: ${color}`,
        ].join('; '),
      });
      i++;
    };
    if (S[r][c] === '#') pushDot(ox + c * cell, oy + r * cell, '#8CCFAD');
    if (P[r][c] === '#') pushDot(ox + (c + 6) * cell, oy + r * cell, r === 0 && c === 0 ? '#D6A64F' : '#F8FAF7');
  }
}

// Puntos de ruido a la izquierda: los datos que todavía no se ordenan
const noise = [];
for (let k = 0; k < 66; k++) {
  const x = Math.round(rnd() * 196 + 14);
  const y = Math.round(rnd() * 360 + 20);
  const size = 4 + Math.round(rnd() * 8);
  const op = (0.25 + (x / 210) * 0.6).toFixed(2);
  noise.push({
    style: [
      `left: ${pct(x, W)}`,
      `top: ${pct(y, H)}`,
      `--size: ${pct(size, W)}`,
      `background: ${k % 5 === 0 ? '#D6A64F' : '#3E9B91'}`,
      `opacity: ${op}`,
    ].join('; '),
  });
}
---
<div class="dots" role="img" aria-label={label} data-dots>
  {noise.map((d) => <span class="dot dot--noise" style={d.style}></span>)}
  {letters.map((d) => <span class="dot dot--sp" style={d.style}></span>)}
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-dots]').forEach((el) => {
    if (reduce || !('IntersectionObserver' in window)) return;
    el.classList.add('is-scattered');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            el.classList.remove('is-scattered');
            io.disconnect();
          }
        });
      },
      { threshold: 0.45 }
    );
    io.observe(el);
  });
</script>

<style>
  .dots {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: var(--green-night);
    overflow: hidden;
  }
  .dot {
    position: absolute;
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .dot--sp {
    left: var(--x1);
    top: var(--y1);
  }
  .dots.is-scattered .dot--sp {
    left: var(--x0);
    top: var(--y0);
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot--sp {
      transition:
        left 1.4s cubic-bezier(0.22, 1, 0.36, 1) var(--delay),
        top 1.4s cubic-bezier(0.22, 1, 0.36, 1) var(--delay),
        opacity 1.4s ease var(--delay);
    }
  }
</style>
