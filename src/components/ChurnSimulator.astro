---
// Simulador del caso "¿Qué clientes están por irse?".
// Usa los 5.000 clientes de prueba del caso (datos sintéticos): probabilidad del modelo,
// valor en riesgo y si abandonó. Con el costo del contacto y la efectividad que elija la
// persona, aplica la regla "contactar si el valor esperado > 0" y calcula la ganancia real
// en prueba, frente a contactar a todos. Los datos se generan con scripts/simulador/exportar_datos.py.
//
// variant="card": versión compacta para tarjetas oscuras (Inicio y Proyectos).
// variant="full": versión completa con curva de ganancia (página del caso).

const { lang = 'es', variant = 'card' } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      title: 'Simulador de campaña',
      cost: 'Costo por contacto',
      eff: 'Efectividad de la campaña',
      effHelp: 'De cada 100 clientes que iban a irse, cuántos retiene el contacto.',
      model: 'Contactar solo a quien vale la pena',
      all: 'Contactar a todos',
      contacts: 'de la base',
      reset: 'Volver a los supuestos del caso',
      note: 'Datos sintéticos de 5.000 clientes de prueba · margen 25 %',
      chartTitle: 'Ganancia según cuántos clientes se contactan',
      chartX: '% de clientes contactados (ordenados por valor esperado)',
      chartLabel: 'Curva de ganancia de la campaña',
      captured: 'de los abandonos alcanzados',
      verdictWin: 'Elegir con el modelo gana',
      verdictMore: 'más que contactar a todos.',
      verdictNone: 'Con estos supuestos no hay a quién contactar: ninguna campaña es rentable.',
      loading: 'Cargando datos del simulador…',
      error: 'No se pudieron cargar los datos del simulador.',
    }
  : {
      title: 'Campaign simulator',
      cost: 'Cost per contact',
      eff: 'Campaign effectiveness',
      effHelp: 'Out of 100 customers who were going to leave, how many the contact retains.',
      model: 'Contact only those worth it',
      all: 'Contact everyone',
      contacts: 'of the base',
      reset: 'Back to the case assumptions',
      note: 'Synthetic data for 5,000 test customers · 25% margin',
      chartTitle: 'Profit by number of customers contacted',
      chartX: '% of customers contacted (ranked by expected value)',
      chartLabel: 'Campaign profit curve',
      captured: 'of churners reached',
      verdictWin: 'Choosing with the model earns',
      verdictMore: 'more than contacting everyone.',
      verdictNone: 'With these assumptions there is no one worth contacting: no campaign is profitable.',
      loading: 'Loading simulator data…',
      error: 'The simulator data could not be loaded.',
    };
const uid = `sim-${variant}-${lang}`;
---
<div class:list={['sim', `sim--${variant}`]} data-sim data-lang={lang} data-variant={variant} data-src="/data/sim-abandono.json" data-i18n={JSON.stringify(T)}>
  {variant === 'full' && <h3 class="sim-title">{T.title}</h3>}

  <div class="sim-controls" data-controls hidden>
    <div class="sim-control">
      <div class="sim-label-row">
        <label for={`${uid}-cost`}>{T.cost}</label>
        <output for={`${uid}-cost`} data-out="cost">COP 5.000</output>
      </div>
      <input id={`${uid}-cost`} type="range" min="1000" max="20000" step="500" value="5000" data-in="cost" />
    </div>
    <div class="sim-control">
      <div class="sim-label-row">
        <label for={`${uid}-eff`}>{T.eff}</label>
        <output for={`${uid}-eff`} data-out="eff">25 %</output>
      </div>
      <input id={`${uid}-eff`} type="range" min="5" max="50" step="1" value="25" data-in="eff" aria-describedby={`${uid}-effhelp`} />
      {variant === 'full' && <p class="sim-help" id={`${uid}-effhelp`}>{T.effHelp}</p>}
    </div>
  </div>

  <div class="sim-results" aria-live="polite" data-results>
    <div class="sim-kpi sim-kpi--model">
      <span class="sim-kpi-label">{T.model}</span>
      <span class="sim-kpi-value" data-out="model">{es ? '+COP 2,8 M' : '+COP 2.8M'}</span>
      <span class="sim-kpi-sub"><span data-out="pct">{es ? '15,5 %' : '15.5%'}</span> {T.contacts}</span>
    </div>
    <div class="sim-kpi sim-kpi--all">
      <span class="sim-kpi-label">{T.all}</span>
      <span class="sim-kpi-value" data-out="all">{es ? '−COP 10,2 M' : '−COP 10.2M'}</span>
      <span class="sim-kpi-sub">100 % {T.contacts}</span>
    </div>
  </div>

  {variant === 'card' && (
    <svg class="sim-bars" viewBox="0 0 400 96" aria-hidden="true" data-bars>
      <line x1="200" y1="4" x2="200" y2="92" class="sim-axis" />
      <rect x="200" y="10" width="46" height="32" rx="6" class="sim-bar sim-bar--model" data-bar="model" />
      <rect x="34" y="54" width="166" height="32" rx="6" class="sim-bar sim-bar--all" data-bar="all" />
    </svg>
  )}

  {variant === 'full' && (
    <figure class="sim-chart">
      <figcaption>{T.chartTitle}</figcaption>
      <svg viewBox="0 0 640 280" role="img" aria-label={T.chartLabel} data-chart>
        <g data-grid></g>
        <path class="sim-curve" d="" data-curve />
        <circle class="sim-dot" r="7" cx="-20" cy="-20" data-dot />
        <text class="sim-dot-label" x="0" y="0" data-dot-label></text>
      </svg>
      <p class="sim-axis-label">{T.chartX}</p>
    </figure>
  )}

  <p class="sim-verdict" data-verdict>
    {T.verdictWin} <strong>{es ? 'COP 13,0 M' : 'COP 13.0M'}</strong> {T.verdictMore}
  </p>

  <div class="sim-foot">
    <span class="sim-note">{T.note}</span>
    <button type="button" class="sim-reset" data-reset hidden>{T.reset}</button>
  </div>
  <p class="sim-status" data-status hidden>{T.loading}</p>
</div>

<script>
  type SimData = { p: number[]; v: number[]; a: number[] };
  const cache = new Map<string, Promise<SimData>>();
  const load = (src: string) => {
    if (!cache.has(src)) cache.set(src, fetch(src).then((r) => { if (!r.ok) throw new Error('data'); return r.json(); }));
    return cache.get(src)!;
  };

  document.querySelectorAll<HTMLElement>('[data-sim]').forEach(async (root) => {
    const lang = root.dataset.lang || 'es';
    const es = lang === 'es';
    const T = JSON.parse(root.dataset.i18n || '{}');
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const nf = new Intl.NumberFormat(es ? 'es-CO' : 'en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    const money = (x: number) => {
      const m = Math.abs(x) / 1e6;
      const sign = x > 0.05e6 ? '+' : x < -0.05e6 ? '−' : '';
      return es ? `${sign}COP ${nf.format(m)} M` : `${sign}COP ${nf.format(m)}M`;
    };
    const moneyAbs = (x: number) => (es ? `COP ${nf.format(Math.abs(x) / 1e6)} M` : `COP ${nf.format(Math.abs(x) / 1e6)}M`);
    const pct = (x: number) => (es ? `${nf.format(x)} %` : `${nf.format(x)}%`);
    const cop = (x: number) => `COP ${x.toLocaleString(es ? 'es-CO' : 'en-US')}`;

    let data: SimData;
    try {
      status.hidden = false;
      data = await load(root.dataset.src!);
      status.hidden = true;
    } catch (e) {
      status.textContent = T.error;
      return;
    }

    const n = data.p.length;
    const V = data.v.map((x) => x * 1000);
    const costIn = root.querySelector<HTMLInputElement>('[data-in="cost"]')!;
    const effIn = root.querySelector<HTMLInputElement>('[data-in="eff"]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    root.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
    resetBtn.hidden = false;

    const compute = (cost: number, eff: number) => {
      const ev = new Float64Array(n);
      const real = new Float64Array(n);
      let all = 0, model = 0, k = 0, churners = 0, reached = 0;
      for (let i = 0; i < n; i++) {
        ev[i] = data.p[i] * eff * V[i] - cost;
        real[i] = data.a[i] * eff * V[i] - cost;
        all += real[i];
        churners += data.a[i];
        if (ev[i] > 0) { model += real[i]; k++; reached += data.a[i]; }
      }
      return { ev, real, all, model, k, captured: churners ? (reached / churners) * 100 : 0 };
    };

    // Curva de ganancia (versión completa)
    const chart = root.querySelector<SVGSVGElement>('[data-chart]');
    const drawChart = (r: ReturnType<typeof compute>) => {
      if (!chart) return;
      const order = Array.from({ length: n }, (_, i) => i).sort((x, y) => r.ev[y] - r.ev[x]);
      const steps = 100;
      const pts: [number, number][] = [[0, 0]];
      let acc = 0, idx = 0;
      for (let s = 1; s <= steps; s++) {
        const upto = Math.round((s / steps) * n);
        while (idx < upto) acc += r.real[order[idx++]];
        pts.push([s, acc]);
      }
      const ruleY = r.model;
      const ys = pts.map((p) => p[1]).concat([0, ruleY]);
      let ymin = Math.min(...ys), ymax = Math.max(...ys);
      const pad = (ymax - ymin) * 0.08 || 1e6;
      ymin -= pad; ymax += pad;
      const W = 640, H = 280, L = 56, R = 16, Tp = 16, B = 28;
      const X = (s: number) => L + (s / steps) * (W - L - R);
      const Y = (v: number) => Tp + ((ymax - v) / (ymax - ymin)) * (H - Tp - B);
      chart.querySelector('[data-curve]')!.setAttribute('d', pts.map((p, i) => `${i ? 'L' : 'M'}${X(p[0]).toFixed(1)},${Y(p[1]).toFixed(1)}`).join(''));
      // Rejilla: línea de cero y 4 marcas en millones
      const grid = chart.querySelector('[data-grid]')!;
      const step = Math.max(1, Math.ceil((ymax - ymin) / 1e6 / 5));
      let g = '';
      for (let m = Math.ceil(ymin / 1e6 / step) * step; m * 1e6 <= ymax; m += step) {
        const y = Y(m * 1e6).toFixed(1);
        g += `<line x1="${L}" x2="${W - R}" y1="${y}" y2="${y}" class="${m === 0 ? 'sim-zero' : 'sim-gridline'}"/>`;
        g += `<text x="${L - 8}" y="${(+y + 4).toFixed(1)}" text-anchor="end" class="sim-tick">${m}${es ? ' M' : 'M'}</text>`;
      }
      [0, 25, 50, 75, 100].forEach((s) => {
        g += `<text x="${X(s).toFixed(1)}" y="${H - 8}" text-anchor="middle" class="sim-tick">${s}${es ? ' %' : '%'}</text>`;
      });
      grid.innerHTML = g;
      const dot = chart.querySelector('[data-dot]')!;
      const label = chart.querySelector('[data-dot-label]')!;
      const sx = (r.k / n) * steps;
      dot.setAttribute('cx', X(sx).toFixed(1));
      dot.setAttribute('cy', Y(ruleY).toFixed(1));
      label.setAttribute('x', (X(sx) + 12).toFixed(1));
      label.setAttribute('y', (Y(ruleY) - 10).toFixed(1));
      label.textContent = r.k ? `${es ? 'Regla' : 'Rule'}: ${pct((r.k / n) * 100)} · ${money(ruleY)}` : '';
    };

    // Barras (versión de tarjeta)
    const bars = root.querySelector<SVGSVGElement>('[data-bars]');
    const drawBars = (r: ReturnType<typeof compute>) => {
      if (!bars) return;
      const max = Math.max(Math.abs(r.model), Math.abs(r.all), 1);
      const scale = 166 / max;
      const place = (el: Element, v: number) => {
        const w = Math.max(2, Math.abs(v) * scale);
        el.setAttribute('width', w.toFixed(1));
        el.setAttribute('x', (v >= 0 ? 200 : 200 - w).toFixed(1));
      };
      place(bars.querySelector('[data-bar="model"]')!, r.model);
      place(bars.querySelector('[data-bar="all"]')!, r.all);
    };

    let timer = 0;
    const update = () => {
      const cost = +costIn.value;
      const eff = +effIn.value / 100;
      out('cost').textContent = cop(cost);
      out('eff').textContent = es ? `${effIn.value} %` : `${effIn.value}%`;
      const r = compute(cost, eff);
      out('model').textContent = r.k ? money(r.model) : (es ? 'COP 0' : 'COP 0');
      out('pct').textContent = pct((r.k / n) * 100);
      out('all').textContent = money(r.all);
      const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
      if (!r.k) verdict.textContent = T.verdictNone;
      else verdict.innerHTML = `${T.verdictWin} <strong>${moneyAbs(r.model - r.all)}</strong> ${T.verdictMore} ${root.dataset.variant === 'full' ? `(${pct(r.captured)} ${T.captured})` : ''}`;
      drawBars(r);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => drawChart(r), 0);
      resetBtn.disabled = costIn.value === '5000' && effIn.value === '25';
    };

    costIn.addEventListener('input', update);
    effIn.addEventListener('input', update);
    resetBtn.addEventListener('click', () => { costIn.value = '5000'; effIn.value = '25'; update(); costIn.focus(); });
    update();
  });
</script>

<style>
  .sim { display: flex; flex-direction: column; gap: 16px; }
  .sim--card { padding: 20px; border-radius: var(--radius-md); background: var(--green-deep); color: var(--white); flex: 1; }
  .sim--full {
    padding: clamp(20px, 3vw, 28px);
    border-radius: 16px;
    background: var(--paper);
    border: 1px solid var(--gray-light);
    color: var(--carbon);
  }
  .sim-title { font-size: 20px; font-weight: 800; color: var(--green-deep); }

  .sim-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px 24px; }
  .sim-controls[hidden] { display: none; }
  .sim-control { display: flex; flex-direction: column; gap: 6px; }
  .sim-label-row { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .sim-label-row label { font-family: var(--font-display); font-weight: 600; font-size: 13px; }
  .sim-label-row output { font-family: var(--font-display); font-weight: 700; font-size: 15px; white-space: nowrap; }
  .sim--card .sim-label-row label { color: var(--on-dark); }
  .sim--card .sim-label-row output { color: var(--mint); }
  .sim--full .sim-label-row output { color: var(--green); }
  .sim-help { font-size: 13px; color: var(--slate); }

  .sim input[type='range'] { width: 100%; min-height: 28px; accent-color: var(--gold); cursor: pointer; }
  .sim--full input[type='range'] { accent-color: var(--green); }

  .sim-results { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sim-kpi { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border-radius: 12px; }
  .sim--card .sim-kpi { background: rgba(255, 255, 255, 0.06); }
  .sim--full .sim-kpi { background: var(--white); border: 1px solid var(--gray-light); }
  .sim-kpi-label { font-size: 12px; line-height: 1.3; }
  .sim--card .sim-kpi-label { color: var(--on-dark); }
  .sim--full .sim-kpi-label { color: var(--slate); }
  .sim-kpi-value { font-family: var(--font-display); font-weight: 800; font-size: clamp(20px, 2.4vw, 26px); line-height: 1.15; }
  .sim--card .sim-kpi--model .sim-kpi-value { color: var(--mint); }
  .sim--full .sim-kpi--model .sim-kpi-value { color: var(--green); }
  .sim--card .sim-kpi--all .sim-kpi-value { color: var(--white); }
  .sim--full .sim-kpi--all .sim-kpi-value { color: var(--slate); }
  .sim-kpi-sub { font-size: 12px; }
  .sim--card .sim-kpi-sub { color: var(--on-dark-muted); }
  .sim--full .sim-kpi-sub { color: var(--slate); }

  .sim-bars { width: 100%; height: auto; }
  .sim-axis { stroke: var(--green-logo); stroke-width: 1.5; }
  .sim-bar { transition: x .25s ease, width .25s ease; }
  .sim-bar--model { fill: var(--mint); }
  .sim-bar--all { fill: #A9B5AE; }
  @media (prefers-reduced-motion: reduce) { .sim-bar { transition: none; } }

  .sim-chart { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .sim-chart figcaption { font-family: var(--font-display); font-weight: 700; font-size: 15px; }
  .sim-chart svg { width: 100%; height: auto; overflow: visible; }
  .sim-chart :global(.sim-gridline) { stroke: var(--gray-light); stroke-width: 1; }
  .sim-chart :global(.sim-zero) { stroke: var(--carbon); stroke-width: 1.5; }
  .sim-chart :global(.sim-tick) { font-family: var(--font-body); font-size: 12px; fill: var(--slate); }
  .sim-curve { fill: none; stroke: var(--green); stroke-width: 3; stroke-linejoin: round; }
  .sim-dot { fill: var(--gold); stroke: var(--white); stroke-width: 3; }
  .sim-dot-label { font-family: var(--font-display); font-weight: 700; font-size: 13px; fill: var(--carbon); }
  .sim-axis-label { font-size: 13px; color: var(--slate); text-align: center; }

  .sim-verdict { font-size: 15px; line-height: 1.45; }
  .sim--card .sim-verdict { color: var(--gray-light); }
  .sim-verdict :global(strong) { font-weight: 700; }
  .sim--card .sim-verdict :global(strong) { color: var(--gold); }
  .sim--full .sim-verdict :global(strong) { color: var(--green); }

  .sim-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; }
  .sim-note { font-size: 12px; }
  .sim--card .sim-note { color: var(--on-dark-muted); }
  .sim--full .sim-note { color: var(--slate); }
  .sim-reset {
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid currentColor;
    background: transparent;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
  }
  .sim-reset[hidden] { display: none; }
  .sim--card .sim-reset { color: var(--mint); }
  .sim--full .sim-reset { color: var(--green); }
  .sim-reset:disabled { opacity: 0.45; cursor: default; }
  .sim-status { font-size: 13px; }
  .sim-status[hidden] { display: none; }
</style>
