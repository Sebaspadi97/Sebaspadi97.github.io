---
// Figura de "El método": 40 puntos que se reacomodan en escenas de analítica.
//   1. Datos y código   2. Modelo y fórmula   3. Hallazgo (barras)
//   4. Proporciones (torta)   5. Proyección y decisión (punto dorado)
// Sin JavaScript o con movimiento reducido se muestra fija la escena de proyección.
// Incluye botón de pausa (WCAG 2.2.2) y se detiene fuera de pantalla.

const { lang = 'es', label } = Astro.props;
const es = lang === 'es';

const N = 40;
const C = { mint: '#8CCFAD', teal: '#3E9B91', logo: '#2F8665', white: '#F8FAF7', gold: '#D6A64F' };

let seed = 11;
const rnd = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const r1 = (n) => Math.round(n * 10) / 10;

// ---------- Escena 1 · Datos y código: nube dispersa bajo el bloque de código
const s1 = Array.from({ length: N }, (_, i) => ({
  x: r1(50 + rnd() * 460),
  y: r1(160 + rnd() * 210),
  s: r1(0.55 + rnd() * 0.7),
  c: i % 4 === 0 ? C.mint : C.teal,
  o: r1(0.45 + rnd() * 0.5),
}));

// ---------- Escena 2 · Modelo: dispersión con tendencia lineal
const s2 = Array.from({ length: N }, (_, i) => {
  const x = 80 + (i / (N - 1)) * 420 + (rnd() - 0.5) * 14;
  const y = 350 - 0.46 * (x - 70) + (rnd() - 0.5) * 70;
  return { x: r1(x), y: r1(y), s: 0.8, c: i % 3 === 0 ? C.mint : C.teal, o: 0.95 };
});

// ---------- Escena 3 · Hallazgo: columnas de puntos apilados (la más alta en dorado)
const cols = [5, 7, 12, 9, 7];
const s3 = [];
cols.forEach((h, ci) => {
  for (let j = 0; j < h; j++) {
    s3.push({ x: 120 + ci * 82, y: 352 - j * 22, s: 1.15, c: ci === 2 ? C.gold : ci % 2 ? C.teal : C.mint, o: 1 });
  }
});

// ---------- Escena 4 · Proporciones: anillo de torta por segmentos
const segs = [[16, C.logo], [12, C.teal], [8, C.mint], [4, C.gold]];
const ringColor = [];
segs.forEach(([n, col]) => { for (let k = 0; k < n; k++) ringColor.push(col); });
const s4 = Array.from({ length: N }, (_, i) => {
  const a = -Math.PI / 2 + (i / N) * Math.PI * 2;
  return { x: r1(280 + Math.cos(a) * 118), y: r1(214 + Math.sin(a) * 118), s: 1.25, c: ringColor[i], o: 1 };
});

// ---------- Escena 5 · Proyección: serie histórica, pronóstico y punto de decisión
const hist = 28;
const s5 = Array.from({ length: N }, (_, i) => {
  if (i < hist) {
    const x = 60 + i * 11.8;
    const y = 318 - 0.36 * (x - 60) - 22 * Math.sin(x / 34) + (rnd() - 0.5) * 12;
    return { x: r1(x), y: r1(y), s: 0.75, c: C.mint, o: 1 };
  }
  const k = i - hist + 1;
  const x = 60 + (hist - 1) * 11.8 + k * 11.2;
  const y = 318 - 0.36 * (x - 60) - 22 * Math.sin(x / 34) * 0.6;
  const last = i === N - 1;
  return { x: r1(x), y: r1(y), s: last ? 1.7 : 0.6, c: last ? C.gold : C.white, o: last ? 1 : 0.55 };
});

const scenes = [s1, s2, s3, s4, s5];
const xToday = r1(60 + (hist - 1) * 11.8 + 5.6);
const end = s5[N - 1];
const startP = s5[hist - 1];
const fan = `M${startP.x},${startP.y} L${end.x},${r1(end.y - 46)} L${end.x},${r1(end.y + 46)} Z`;

const captions = es
  ? ['01 · Datos y código', '02 · Modelo', '03 · Hallazgo', '04 · Proporciones', '05 · Proyección y decisión']
  : ['01 · Data and code', '02 · Model', '03 · Finding', '04 · Proportions', '05 · Forecast and decision'];
const t = es
  ? { pause: 'Pausar animación', play: 'Reanudar animación', today: 'hoy', decision: 'decisión', max: 'máx.' }
  : { pause: 'Pause animation', play: 'Play animation', today: 'today', decision: 'decision', max: 'max.' };
const initial = scenes.length - 1;
const dotStyle = (d) => `transform: translate(${d.x}px, ${d.y}px) scale(${d.s}); fill: ${d.c}; opacity: ${d.o}`;
---
<div class="am" data-am data-scenes={JSON.stringify(scenes)} data-captions={JSON.stringify(captions)} data-labels={JSON.stringify(t)}>
  <svg class="am-svg" viewBox="0 0 560 420" role="img" aria-label={label}>
    <!-- Capas de cada escena -->
    <g class="am-layer" data-layer="0">
      <text class="am-code" x="40" y="58"><tspan class="am-kw">import</tspan> pandas <tspan class="am-kw">as</tspan> pd</text>
      <text class="am-code" x="40" y="84">df = pd.read_csv(<tspan class="am-str">"datos.csv"</tspan>)</text>
      <text class="am-code" x="40" y="110">df.describe()</text>
      <rect class="am-cursor" x="160" y="98" width="9" height="16" />
    </g>

    <g class="am-layer" data-layer="1">
      <line class="am-axis" x1="52" y1="60" x2="52" y2="376" />
      <line class="am-axis" x1="52" y1="376" x2="530" y2="376" />
      <line class="am-fit" x1="64" y1="353" x2="512" y2="147" />
      <text class="am-formula" x="76" y="78">f(x) = β₀ + β₁·x</text>
      <text class="am-code am-code--dim" x="76" y="104">model.fit(X, y)</text>
    </g>

    <g class="am-layer" data-layer="2">
      <line class="am-axis" x1="80" y1="372" x2="500" y2="372" />
      <text class="am-tag" x="284" y="74" text-anchor="middle">{t.max}</text>
      <path class="am-arrow" d="M284 84 L284 98" />
    </g>

    <g class="am-layer" data-layer="3">
      <circle class="am-ring" cx="280" cy="214" r="118" />
      <text class="am-big" x="280" y="214" text-anchor="middle">100 %</text>
      <text class="am-code am-code--dim" x="280" y="242" text-anchor="middle">Σ pᵢ = 1</text>
    </g>

    <g class="am-layer is-on" data-layer="4">
      <path class="am-fan" d={fan} />
      <line class="am-axis" x1="52" y1="376" x2="530" y2="376" />
      <line class="am-today" x1={xToday} y1="70" x2={xToday} y2="376" />
      <text class="am-tag" x={xToday} y="62" text-anchor="middle">{t.today}</text>
      <path class="am-proj" d={`M${startP.x},${startP.y} L${end.x},${end.y}`} />
      <text class="am-code am-code--dim" x="40" y="58">model.predict(futuro)</text>
      <text class="am-tag am-tag--gold" x={end.x} y={r1(end.y - 22)} text-anchor="end">{t.decision}</text>
    </g>

    <!-- Los 40 puntos: se mueven entre escenas -->
    <g class="am-dots">
      {scenes[initial].map((d) => <circle r="6" cx="0" cy="0" style={dotStyle(d)} />)}
    </g>
  </svg>

  <p class="am-caption" aria-hidden="true" data-caption>{captions[initial]}</p>
  <button type="button" class="am-toggle" data-toggle aria-label={t.pause} hidden>
    <svg class="am-i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
    <svg class="am-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
  </button>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-am]').forEach((root) => {
    if (reduce) return;
    const scenes = JSON.parse(root.dataset.scenes || '[]');
    const captions = JSON.parse(root.dataset.captions || '[]');
    const labels = JSON.parse(root.dataset.labels || '{}');
    const dots = Array.from(root.querySelectorAll<SVGCircleElement>('.am-dots circle'));
    const layers = Array.from(root.querySelectorAll<SVGGElement>('[data-layer]'));
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const HOLD = 3400;

    let current = scenes.length - 1;
    let timer = 0;
    let visible = false;
    let paused = false;

    const show = (k: number) => {
      current = k;
      scenes[k].forEach((d: any, i: number) => {
        const el = dots[i];
        el.style.transitionDelay = `${(i % 10) * 28}ms`;
        el.style.transform = `translate(${d.x}px, ${d.y}px) scale(${d.s})`;
        el.style.fill = d.c;
        el.style.opacity = String(d.o);
      });
      layers.forEach((l) => l.classList.toggle('is-on', Number(l.dataset.layer) === k));
      caption.textContent = captions[k];
    };

    const tick = () => {
      show((current + 1) % scenes.length);
      schedule();
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (visible && !paused && !document.hidden) timer = window.setTimeout(tick, HOLD);
    };

    toggle.hidden = false;
    root.classList.add('is-live');
    toggle.addEventListener('click', () => {
      paused = !paused;
      root.classList.toggle('is-paused', paused);
      toggle.setAttribute('aria-label', paused ? labels.play : labels.pause);
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const was = visible;
            visible = e.isIntersecting;
            if (visible && !was) {
              window.clearTimeout(timer);
              timer = window.setTimeout(tick, 900);
            } else if (!visible) {
              window.clearTimeout(timer);
            }
          });
        },
        { threshold: 0.35 }
      ).observe(root);
    } else {
      visible = true;
      schedule();
    }
  });
</script>

<style>
  .am {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: var(--green-night);
    overflow: hidden;
  }
  .am-svg { width: 100%; height: 100%; display: block; }

  .am-dots circle { transform-box: view-box; transform-origin: 0 0; }
  .is-live .am-dots circle {
    transition:
      transform 1.1s cubic-bezier(0.65, 0, 0.35, 1),
      fill 0.9s ease,
      opacity 0.9s ease;
  }

  .am-layer { opacity: 0; transition: opacity 0.5s ease; }
  .am-layer.is-on { opacity: 1; transition: opacity 0.7s ease 0.55s; }

  .am-code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 15px; fill: var(--on-dark); }
  .am-code--dim { fill: var(--on-dark-muted); font-size: 14px; }
  .am-kw { fill: var(--mint); }
  .am-str { fill: var(--gold); }
  .am-cursor { fill: var(--mint); }
  .is-live .am-layer.is-on .am-cursor { animation: am-blink 1s steps(1) infinite; }
  @keyframes am-blink { 50% { opacity: 0; } }

  .am-axis { stroke: var(--green-logo); stroke-width: 1.5; }
  .am-fit { stroke: var(--white); stroke-width: 2; stroke-dasharray: 520; stroke-dashoffset: 0; }
  .is-live .am-layer .am-fit { stroke-dashoffset: 520; transition: stroke-dashoffset 1s ease; }
  .is-live .am-layer.is-on .am-fit { stroke-dashoffset: 0; transition: stroke-dashoffset 1.2s ease 0.9s; }
  .am-formula { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 22px; font-weight: 600; fill: var(--white); }

  .am-tag { font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; fill: var(--mint); }
  .am-tag--gold { fill: var(--gold); }
  .am-arrow { stroke: var(--gold); stroke-width: 2; fill: none; }

  .am-ring { fill: none; stroke: var(--green-logo); stroke-width: 1; stroke-dasharray: 3 6; }
  .am-big { font-family: var(--font-display); font-size: 34px; font-weight: 800; fill: var(--white); dominant-baseline: middle; }

  .am-fan { fill: var(--mint); opacity: 0.14; }
  .am-today { stroke: var(--on-dark-muted); stroke-width: 1; stroke-dasharray: 3 5; }
  .am-proj { stroke: var(--white); stroke-width: 1.5; stroke-dasharray: 5 6; fill: none; opacity: 0.7; }

  .am-caption {
    position: absolute;
    left: 24px;
    bottom: 18px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mint);
  }

  .am-toggle {
    position: absolute;
    right: 12px;
    bottom: 8px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(140, 207, 173, 0.45);
    background: rgba(17, 41, 31, 0.7);
    color: var(--mint);
    cursor: pointer;
  }
  .am-toggle:hover { border-color: var(--mint); }
  .am-toggle svg { width: 18px; height: 18px; fill: currentColor; }
  .am-toggle[hidden] { display: none; }
  .am-i-play { display: none; }
  .is-paused .am-i-pause { display: none; }
  .is-paused .am-i-play { display: block; }
</style>
